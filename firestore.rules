rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 1. Global Catch-All Safety Net (Default Deny)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Reusable Global Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'admin@nammashop.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mjjayan2007@gmail.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'gughan4912@gmail.com') ||
        (request.auth.token.email != null && request.auth.token.email.lower().endsWith('@nammashop.com')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------------------
    // COLLECTION: /users
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (
        // Forbid standard users from escalating their own privileges
        incoming().role == existing().role &&
        incoming().isBanned == existing().isBanned &&
        incoming().createdAt == existing().createdAt
      ) || isAdmin();
      allow delete: if isAdmin();

      function isValidUser(data) {
        return data.keys().hasAll(['id', 'email', 'name', 'role', 'createdAt']) &&
               data.keys().size() <= 8 &&
               data.id is string && data.id.size() <= 128 &&
               data.email is string && data.email.size() <= 200 &&
               data.name is string && data.name.size() <= 100 &&
               data.role in ['admin', 'customer', 'delivery_partner', 'store_staff'] &&
               (data.phone == null || (data.phone is string && data.phone.size() <= 20)) &&
               (data.avatar == null || (data.avatar is string && data.avatar.size() <= 1024)) &&
               (data.isBanned == null || data.isBanned is bool) &&
               data.createdAt is string;
      }

      // -------------------------------------------------------------------------
      // SUBCOLLECTION: /users/{userId}/addresses
      // -------------------------------------------------------------------------
      match /addresses/{addressId} {
        allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow create: if isSignedIn() && isOwner(userId) && isValidId(addressId) && isValidAddress(incoming());
        allow update: if isSignedIn() && isOwner(userId) && isValidId(addressId) && isValidAddress(incoming());
        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());

        function isValidAddress(data) {
          return data.keys().hasAll(['id', 'label', 'fullName', 'street', 'city', 'state', 'pincode', 'phone']) &&
                 data.keys().hasAny(['landmark']) &&
                 data.keys().size() <= 9 &&
                 data.id is string && data.id.size() <= 128 &&
                 data.label is string && data.label.size() <= 50 &&
                 data.fullName is string && data.fullName.size() <= 100 &&
                 data.street is string && data.street.size() <= 500 &&
                 data.city is string && data.city.size() <= 100 &&
                 data.state is string && data.state.size() <= 100 &&
                 data.pincode is string && data.pincode.size() <= 10 &&
                 data.phone is string && data.phone.size() <= 20 &&
                 (data.landmark == null || (data.landmark is string && data.landmark.size() <= 500));
        }
      }
    }

    // -------------------------------------------------------------------------
    // COLLECTION: /categories
    // -------------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true; // Public catalog access
      allow create, update, delete: if isAdmin() && isValidId(categoryId);
    }

    // -------------------------------------------------------------------------
    // COLLECTION: /products
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow read: if true; // Public catalog access
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if (isAdmin() && isValidId(productId) && isValidProduct(incoming())) || (
        // Customer can only update reviews rating aggregates or stock when buying
        isSignedIn() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['stock']) &&
        incoming().stock >= 0 &&
        incoming().stock is number
      );
      allow delete: if isAdmin();

      function isValidProduct(data) {
        return data.keys().hasAll(['id', 'name', 'slug', 'price', 'discount', 'stock', 'image', 'categoryId', 'unit']) &&
               data.id is string && data.id.size() <= 128 &&
               data.name is string && data.name.size() <= 200 &&
               data.slug is string && data.slug.size() <= 200 &&
               data.price is number && data.price >= 0 &&
               data.discount is number && data.discount >= 0 &&
               data.stock is number && data.stock >= 0 &&
               data.image is string && data.image.size() <= 2048 &&
               data.categoryId is string && data.categoryId.size() <= 128 &&
               data.unit is string && data.unit.size() <= 50;
      }

      // -------------------------------------------------------------------------
      // SUBCOLLECTION: /products/{productId}/reviews
      // -------------------------------------------------------------------------
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming());
        allow update, delete: if isAdmin() || (isSignedIn() && existing().userName == request.auth.token.name);

        function isValidReview(data) {
          return data.keys().hasAll(['id', 'productId', 'userName', 'rating', 'comment', 'date']) &&
                 data.id is string && data.id.size() <= 128 &&
                 data.productId == productId &&
                 data.userName is string && data.userName.size() <= 100 &&
                 data.rating is number && data.rating >= 1 && data.rating <= 5 &&
                 data.comment is string && data.comment.size() <= 2000 &&
                 data.date is string;
        }
      }
    }

    // -------------------------------------------------------------------------
    // COLLECTION: /orders
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && (
        incoming().userId == request.auth.uid
      );
      allow update: if isAdmin() || (
        // Users can cancel their order (can only modify the status to Cancelled)
        isSignedIn() &&
        incoming().userId == request.auth.uid &&
        existing().status != 'Delivered' &&
        existing().status != 'Cancelled' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'timeline']) &&
        incoming().status == 'Cancelled'
      );
      allow delete: if isAdmin();

      function isValidOrder(data) {
        return data.keys().hasAll(['id', 'userId', 'userEmail', 'userName', 'items', 'subtotal', 'discount', 'tax', 'deliveryFee', 'total', 'status', 'paymentMethod', 'paymentStatus', 'address', 'createdAt', 'timeline']) &&
               data.id is string && data.id.size() <= 128 &&
               data.userId is string && data.userId.size() <= 128 &&
               data.userEmail is string && data.userEmail.size() <= 200 &&
               data.userName is string && data.userName.size() <= 100 &&
               data.items is list && data.items.size() > 0 &&
               data.subtotal is number && data.subtotal >= 0 &&
               data.discount is number && data.discount >= 0 &&
               data.tax is number && data.tax >= 0 &&
               data.deliveryFee is number && data.deliveryFee >= 0 &&
               data.total is number && data.total >= 0 &&
               data.status in ['Pending', 'Packed', 'Shipped', 'Out for delivery', 'Delivered', 'Cancelled'] &&
               data.paymentMethod is string &&
               data.paymentStatus is string &&
               data.address is map &&
               data.createdAt is string &&
               data.timeline is list;
      }
    }

    // -------------------------------------------------------------------------
    // COLLECTIONS: realtime logistics, drivers, messages, notifications, analytics
    // -------------------------------------------------------------------------
    function isDeliveryPartner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'delivery_partner';
    }

    function isStoreStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'store_staff';
    }

    match /tracking/{orderId} {
      allow read: if isAdmin() || isDeliveryPartner() || isStoreStaff() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin() || isDeliveryPartner() || isStoreStaff();
    }

    match /deliveries/{deliveryId} {
      allow read: if isAdmin() || isDeliveryPartner() || isStoreStaff() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin() || isDeliveryPartner() || isStoreStaff();
    }

    match /drivers/{driverId} {
      allow read: if isAdmin() || isDeliveryPartner() || isStoreStaff() || isSignedIn();
      allow create, update: if isAdmin() || (isDeliveryPartner() && request.auth.uid == driverId);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || isDeliveryPartner() || isStoreStaff();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /messages/{orderId}/items/{messageId} {
      allow read: if isAdmin() || isDeliveryPartner() || isStoreStaff() ||
        (isSignedIn() && exists(/databases/$(database)/documents/orders/$(orderId)) &&
         get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.text is string && request.resource.data.text.size() <= 800;
      allow update, delete: if isAdmin();
    }

    match /analytics/{analyticsId} {
      allow read: if isAdmin() || isStoreStaff();
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // COLLECTION: /coupons
    // -------------------------------------------------------------------------
    match /coupons/{couponId} {
      allow read: if true; // Public catalog access
      allow create, update, delete: if isAdmin() && isValidId(couponId);
    }

    // -------------------------------------------------------------------------
    // COLLECTION: /banners
    // -------------------------------------------------------------------------
    match /banners/{bannerId} {
      allow read: if true; // Public access to homepage sliders
      allow create, update, delete: if isAdmin() && isValidId(bannerId);
    }
  }
}
